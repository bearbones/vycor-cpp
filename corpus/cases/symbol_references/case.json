       },
       {
        "referrer": "bump",
        "role": "write"
       },
       {
        "referrer": "only_here",
        "role": "read"
       },
       {
        "referrer": "only_here",
        "role": "write"
       },
       {
        "referrer": "peek",
        "role": "read"
       }
      ]
     }
    ]
   }
  },
