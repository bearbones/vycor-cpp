{
 "schema": 1,
 "title": "A global, a header-declared function only its own TU uses, a file-local static, an address-taken callback and a dynamic class across two TUs: linkage, defining TU, per-role referrers, and whether any reference crosses a TU",
 "sources": [
  "store.cpp",
  "main.cpp"
 ],
 "queries": [
  {
   "id": "global-is-external-and-used-elsewhere",
   "argv": [
    "lookup-symbol",
    "--name",
    "counter"
   ],
   "expect": {
    "exit": 0,
    "status": "ok",
    "fields": {
     "kind": "variable",
     "linkage": "external",
     "definingTuCount": 1,
     "declaredInHeader": true,
     "referencedFromOtherTu": true,
     "referrers": {
      "read": 3,
      "write": 2,
      "call": 0,
      "address_of": 0
     }
    },
    "regex": {
     "definingTu": "/store\\.cpp$"
    },
    "count": {
     "declarations": 2
    },
    "witnesses": [
     {
      "in": "declarations",
      "match": {
       "line": 2,
       "definition": false,
       "inHeader": true
      }
     },
     {
      "in": "declarations",
      "match": {
       "line": 3,
       "definition": true,
       "inHeader": false
      }
     }
    ],
    "negatives": [
     {
      "in": "declarations",
      "match": {
       "definition": true,
       "inHeader": true
      }
     }
    ]
   }
  },
  {
   "id": "declared-in-header-used-by-one-tu",
   "argv": [
    "lookup-symbol",
    "--name",
    "only_here"
   ],
   "expect": {
    "exit": 0,
    "status": "ok",
    "fields": {
     "kind": "function",
     "linkage": "external",
     "definingTuCount": 1,
     "declaredInHeader": true,
     "referencedFromOtherTu": false,
     "referrers": {
      "call": 1,
      "address_of": 0
     }
    },
    "regex": {
     "definingTu": "/store\\.cpp$"
    }
   }
  },
  {
   "id": "static-is-internal",
   "argv": [
    "lookup-symbol",
    "--name",
    "scale"
   ],
   "expect": {
    "exit": 0,
