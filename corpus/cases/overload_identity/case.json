  {
   "id": "name-is-ambiguous",
   "argv": [
    "get-callers",
    "--name",
    "f"
   ],
   "expect": {
    "exit": 4,
    "status": "ambiguous",
    "fields": {
     "ambiguous": true,
     "total_candidates": 2
    },
    "witnesses": [
     {
      "in": "candidates",
      "match": {
       "usr": "c:@F@f#I#"
      }
     },
     {
      "in": "candidates",
      "match": {
       "usr": "c:@F@f#d#"
      }
     }
    ]
   }
  },
  {
